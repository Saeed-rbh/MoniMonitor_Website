# Server runtime
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000,http://localhost:5173
PUBLIC_APP_URL=https://monimonitor.example.com
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
# Registration is closed after the first account by default. Set true only
# during a deliberate, temporary bootstrap window.
REGISTRATION_ENABLED=false
# Restrict whole-database backup operations to loopback, private LAN, or
# Tailscale addresses. This intentionally disables them through a public proxy.
BACKUP_PRIVATE_NETWORK_ONLY=true

# Email/AI ingestion (disabled by default; requires account-owner consent)
AI_INGESTION_ENABLED=false
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password
# First durable sync scans all mail from this date; later restarts resume by IMAP UID.
IMAP_INITIAL_SYNC_SINCE=2026-08-11T18:45:00.000Z
AI_API_KEY=your_gemini_api_key
USER_ID=your_monimonitor_user_id
# Durable email ingestion leases and retries. Failed work moves to dead after
# the maximum attempt count and is surfaced by /health for operator review.
EMAIL_QUEUE_MAX_ATTEMPTS=8
EMAIL_QUEUE_LEASE_MS=300000
EMAIL_QUEUE_BACKOFF_CAP_MS=3600000

# Plaid transaction fallback. Access tokens are encrypted with the dedicated key
# below, or JWT_SECRET when a dedicated key is not supplied.
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=CA
PLAID_TOKEN_ENCRYPTION_KEY=replace_with_a_separate_long_random_secret
# Public HTTPS receiver for Transactions, Holdings, Investments, and Item events.
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
# Independent safety-net poll that catches any webhook missed while the server was offline.
PLAID_RECONCILIATION_INTERVAL_HOURS=24

# CAD market quote refresh: weekdays, 09:00 through 14:00 Toronto time, every 15 minutes.
MARKET_QUOTES_ENABLED=true
MARKET_QUOTES_TIMEZONE=America/Toronto

# Consistent SQLite snapshots (defaults to server/backups)
MONIMONITOR_BACKUP_DIR=
MONIMONITOR_BACKUP_INTERVAL_HOURS=24

# Hosted TimesFM expense forecasting with BigQuery. Keep the credential file
# outside this repository and never commit it.
GCP_PROJECT_ID=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=C:\\secure\\path\\to\\service-account.json
BIGQUERY_LOCATION=US
# Cost guard: every prediction query is limited to BigQuery's 10 MB minimum.
TIMESFM_MAX_BYTES_BILLED=10485760

# Telegram account link
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_authorized_chat_id
TELEGRAM_USER_ID=your_authorized_telegram_user_id
# Telegram delivery is durable and independent of the email worker.
TELEGRAM_REQUEST_TIMEOUT_MS=15000
TELEGRAM_OUTBOX_MAX_ATTEMPTS=8
TELEGRAM_OUTBOX_LEASE_MS=120000
TELEGRAM_OUTBOX_POLL_INTERVAL_MS=5000
# Backup controls operate on the whole SQLite database. Set this to the sole
# application owner. USER_ID remains the compatibility fallback.
BACKUP_OWNER_USER_ID=your_monimonitor_user_id
