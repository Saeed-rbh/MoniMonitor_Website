{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "forceConsistentCasingInFileNames": true, // Enforces consistent file name casing
    "strict": true, // Enables all strict type-checking options
    "esModuleInterop": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "src"
  ]
}
